# Token aus dem Cloudflare Zero Trust Dashboard (Networks -> Tunnels). Niemals committen!
TUNNEL_TOKEN=

# Lokaler Port für den Browser-Test (Standard 18080). Bei Portkonflikt ändern.
# Für den Betrieb nur über den Tunnel wird er nicht benötigt.
APP_PORT=18080

# Einladungscode für neue Sync-Konten. Frei wählbar, gib ihn nur den Personen, die ein Konto anlegen sollen.
# Leer = niemand kann ein Konto anlegen. Bitte einen langen, zufälligen Wert verwenden.
INVITE_CODE=
